APP_NAME="RAG Chatbot"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_DATABASE=database/database.sqlite

QUEUE_CONNECTION=database
# Longer than the indexing job's 900-second timeout, so a running job is never started twice
DB_QUEUE_RETRY_AFTER=960

FILESYSTEM_DISK=local

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=120
OLLAMA_NUM_CTX=8192

# Answer-writing model: "ollama" (local) or "openai" (Groq, Cerebras, OpenRouter, ...)
RAG_CHAT_DRIVER=ollama
RAG_HISTORY_MESSAGES=6
OPENAI_COMPAT_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=openai/gpt-oss-120b
# Tried in order when the model above is rate limited (Groq limits each model separately)
OPENAI_COMPAT_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Seconds to wait out a rate limit before giving up (free tiers allow few tokens per minute)
OPENAI_COMPAT_MAX_WAIT=15

QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=rag_hybrid
# bge-small-en-v1.5 makes 384-dimensional vectors
QDRANT_VECTOR_SIZE=384
QDRANT_DISTANCE=Cosine

PDFTOTEXT_BINARY=pdftotext
PDFTOHTML_BINARY=pdftohtml
PDFTOPPM_BINARY=pdftoppm
RAG_TOP_K=5
RAG_CANDIDATE_POOL=20
RAG_LEXICAL_WEIGHT=0.3
RAG_MAX_CONTEXT_CHARS=16000

# Dense embeddings: "tei" (bge-small container) or "ollama"
RAG_EMBEDDING_DRIVER=tei
TEI_EMBEDDINGS_URL=http://127.0.0.1:8081

# Chunks: children (~280 tokens) are searched, parents (~900 tokens) are read by the model
RAG_CHILD_CHUNK_CHARS=1100
RAG_CHUNK_OVERLAP_SENTENCES=1
RAG_PARENT_CHUNK_CHARS=3600

# Hybrid search: dense + BM25 fused with Reciprocal Rank Fusion (60 = original paper, 2 = Qdrant default)
RAG_RRF_K=60
# "cross_encoder" (MiniLM container), "lexical" or "none"
RAG_RERANKER=cross_encoder
TEI_RERANKER_URL=http://127.0.0.1:8082

# Region/chapter filters from the question: "rules", "llm" or "none"
RAG_ROUTER=rules

# Chart pages described by a vision model: "auto", "all" or "none"
RAG_VISION_PAGES=auto
RAG_VISION_MODEL=qwen/qwen3.8-27b
# Seconds of vision calls per document; skipped pages are picked up by the next re-index
RAG_VISION_BUDGET_SECONDS=300
RAG_VISION_MAX_DOCUMENT_PAGES=40
